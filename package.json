{
  "name": "garage-challenge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "catalog": "vite-node scripts/build-catalog.ts",
    "dev": "npm run catalog && vite",
    "build": "npm run catalog && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run catalog && vitest run",
    "typecheck": "npm run catalog && tsc -b --noEmit",
    "audit": "node scripts/audit.mjs",
    "coverage": "vite-node scripts/coverage.ts",
    "images": "vite-node scripts/fetch-images.ts",
    "placeholders": "vite-node scripts/dev-placeholders.ts",
    "images:reset": "node -e \"require('fs').writeFileSync('src/data/generated/images.json','{}')\" && rm -rf public/vehicles"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
